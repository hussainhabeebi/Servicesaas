{
  "name": "@serviceos/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "migrate:staging": "wrangler d1 migrations apply serviceos-staging --env staging --remote",
    "migrate:production": "wrangler d1 migrations apply serviceos-production --env production --remote"
  },
  "dependencies": {
    "@serviceos/platform": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.3",
    "pdf-lib": "^1.17.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.78.10"
  }
}
